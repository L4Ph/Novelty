---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const qas = [
  {
    question: "「小説家になろう」のアカウントでログインできますか？（ブックマーク連携はできますか？）",
    answer: "現在、Novelty はプライバシー保護とセキュリティの観点から、公式サイトへのログイン機能やブックマークの直接同期機能は提供していません。\nその代わり、強力な検索機能やローカルでのライブラリ管理、バックアップ機能を提供しています。"
  },
  {
    question: "iOS(iPhone/iPad)版はありますか？",
    answer: "技術的には対応しており、ソースコードからビルドすることで基本的な動作は可能なはずですが、動作確認が取れていません。\nApp Store での公開も現在未定です。\n将来的には対応を検討しています。"
  },
  {
    question: "「カクヨム」や「ハーメルン」など、他の小説サイトには対応していますか？",
    answer: "「小説家になろう」と「カクヨム」に対応しています。\n同じ操作感でランキングや検索、縦書き読書やオフライン保存が使えます。"
  },
  {
    question: "アプリ内に広告は表示されますか？",
    answer: "一切表示されません。(作者本人が表示されてほしくありません。)\n読書への没入感を最優先し、余計なネットワーク通信をすべて排除しているため、今後も広告を導入する予定はありません。"
  },
  {
    question: "オフラインで読むことはできますか？",
    answer: "はい、可能です。\n小説をダウンロードすることで、インターネット接続がない環境でも快適に読むことができます。"
  },
  {
    question: "縦書き表示には対応していますか？",
    answer: "はい、対応しています。\n設定から「縦書き」モードに切り替えることで、文庫本のような縦書きスタイルで閲覧できます。\nフォントや文字サイズの変更も可能です。"
  },
  {
    question: "データのバックアップは可能ですか？",
    answer: "はい、設定の「データとストレージ」から、ライブラリや閲覧履歴を含むすべてのデータをファイルとして書き出し（エクスポート）、復元（インポート）することができます。"
  },
  {
    question: "推奨環境や対応プラットフォームを教えてください。",
    answer: "現在はAndroidを主対象として開発および動作確認を行っています。\nWindows、macOS、Linuxでもビルド・動作可能ですが、レイアウトの最適化はAndroidが優先されています。"
  },
  {
    question: "アプリのインストール・アップデート方法は？",
    answer: "Google Playでの配信準備中のため、現在はベータテストとして配布しています。手順は次の通りです。\n1. <a href='https://groups.google.com/g/novelty-app' target='_blank' rel='noopener noreferrer'>Googleグループに参加する</a>\n2. <a href='https://play.google.com/apps/testing/moe.l4ph.novelty' target='_blank' rel='noopener noreferrer'>テスト参加リンクを開いて参加する</a>\n3. Google Playからインストールする\n代替手段として、オープンソースのアプリストア「<a href='https://obtainium.imranr.dev/' target='_blank' rel='noopener noreferrer'>Obtainium</a>」でGitHub Releasesからの自動更新も使えます。\nObtainiumが入っていれば、<a href='obtainium://add/https://github.com/L4Ph/Novelty'>ワンタップで追加する</a>こともできます。"
  }
];

const schema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": qas.map(qa => ({
    "@type": "Question",
    "name": qa.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": qa.answer
    }
  }))
};
---

<Layout 
  title="よくある質問 - Novelty"
  description="Noveltyに関するよくある質問（FAQ）と回答をまとめています。推奨環境、インストール方法、機能についてなど。"
  image="/ogp-help.png"
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(schema)} />
  <Navbar />
  <main class="main-container">
    <h1 class="page-title">よくある質問</h1>
    
    <div class="qa-list">
      {qas.map((qa) => (
        <div class="qa-item">
          <h3 class="question">
            <span class="q-mark">Q.</span>
            <span class="q-text">{qa.question}</span>
          </h3>
          <div class="answer">
            <span class="a-mark">A.</span>
            <div class="a-text" set:html={qa.answer} />
          </div>
        </div>
      ))}
    </div>
  </main>
  <Footer />
</Layout>

<style>
  .main-container {
    width: 100%;
    max-width: 56rem; /* 4xl */
    margin: 0 auto;
    padding: 4rem 1rem; /* px-4 py-16 */
    min-height: 80vh;
  }

  .page-title {
    font-size: 1.875rem;
    font-weight: 700;
    text-align: center;
    margin-bottom: 3rem;
    color: var(--text-primary);
  }

  /* QA List */
  .qa-list {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .qa-item {
    background-color: var(--surface-raised);
    border: 1px solid var(--border-subtle);
    padding: 1.5rem;
    border-radius: var(--radius-lg);
  }

  /* Question */
  .question {
    font-size: 1.25rem; /* xl */
    font-weight: 700;
    margin-bottom: 1rem;
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    line-height: 1.4;
  }

  .q-mark {
    color: var(--brand-primary);
    font-size: 1.5rem; /* 2xl */
    font-weight: 900;
    line-height: 1;
  }

  .q-text {
    padding-top: 0.125rem;
  }

  /* Answer */
  .answer {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    color: var(--text-secondary);
    line-height: 1.8;
    white-space: pre-line;
  }

  .a-mark {
    color: var(--brand-primary-hover);
    font-size: 1.5rem; /* 2xl */
    font-weight: 900;
    line-height: 1;
  }

  .a-text {
    padding-top: 0.125rem;
  }

  /* Link styles within Answer */
  .a-text :global(a) {
    color: var(--brand-primary) !important;
    text-decoration: underline !important;
    font-weight: 600;
  }
  
  .a-text :global(a:hover) {
    text-decoration: none !important;
  }

  /* Responsive */
  @media (min-width: 768px) { /* md */
    .page-title {
      font-size: 2.25rem; /* 4xl */
    }
  }
</style>
