---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { getCollection, getEntry } from 'astro:content';

// ページ文面・FAQはJSONコンテンツが真実。ここに直書きしない。
const helpMeta = await getEntry('pages', 'help');
if (!helpMeta) throw new Error('help page content is missing');
const faqs = (await getCollection('faq')).sort((a, b) => a.data.order - b.data.order);

// 構造化データ用に回答HTMLからタグを落として平文にする。
const plainText = (html: string) =>
  html.replace(/<[^>]+>/g, '').replace(/\s+/g, ' ').trim();

const schema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(faq => ({
    "@type": "Question",
    "name": faq.data.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": plainText(faq.data.answer)
    }
  }))
};
---

<Layout 
  title={helpMeta.data.title}
  description={helpMeta.data.description}
  image={helpMeta.data.image}
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(schema)} />
  <Navbar />
  <main class="main-container">
    <h1 class="page-title">よくある質問</h1>
    
    <div class="qa-list">
      {faqs.map((faq) => (
        <div class="qa-item">
          <h3 class="question">
            <span class="q-mark">Q.</span>
            <span class="q-text">{faq.data.question}</span>
          </h3>
          <div class="answer">
            <span class="a-mark">A.</span>
            <div class="a-text" set:html={faq.data.answer} />
          </div>
        </div>
      ))}
    </div>
  </main>
  <Footer />
</Layout>

<style>
  .main-container {
    width: 100%;
    max-width: 56rem; /* 4xl */
    margin: 0 auto;
    padding: 4rem 1rem; /* px-4 py-16 */
    min-height: 80vh;
  }

  .page-title {
    font-size: 1.875rem;
    font-weight: 700;
    text-align: center;
    margin-bottom: 3rem;
    color: var(--text-primary);
  }

  /* QA List */
  .qa-list {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .qa-item {
    background-color: var(--surface-raised);
    border: 1px solid var(--border-subtle);
    padding: 1.5rem;
    border-radius: var(--radius-lg);
  }

  /* Question */
  .question {
    font-size: 1.25rem; /* xl */
    font-weight: 700;
    margin-bottom: 1rem;
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    line-height: 1.4;
  }

  .q-mark {
    color: var(--brand-primary);
    font-size: 1.5rem; /* 2xl */
    font-weight: 900;
    line-height: 1;
  }

  .q-text {
    padding-top: 0.125rem;
  }

  /* Answer */
  .answer {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    color: var(--text-secondary);
    line-height: 1.8;
    white-space: pre-line;
  }

  .a-mark {
    color: var(--brand-primary-hover);
    font-size: 1.5rem; /* 2xl */
    font-weight: 900;
    line-height: 1;
  }

  .a-text {
    padding-top: 0.125rem;
  }

  /* Link styles within Answer */
  .a-text :global(a) {
    color: var(--brand-primary) !important;
    text-decoration: underline !important;
    font-weight: 600;
  }
  
  .a-text :global(a:hover) {
    text-decoration: none !important;
  }

  /* Responsive */
  @media (min-width: 768px) { /* md */
    .page-title {
      font-size: 2.25rem; /* 4xl */
    }
  }
</style>
