---
import "../styles/global.css";

import { ClientRouter } from 'astro:transitions';

interface Props {
	title?: string;
	description?: string;
	image?: string;
	type?: string;
}

const { 
	title = "Novelty - Modern Novel Reader",
	description = "なろう・カクヨム対応。広告なし・オフライン対応のFlutter製小説ビューアー。",
	image = "/ogp.png",
	type = "website"
} = Astro.props;
---

<!doctype html>
<html lang="ja" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<ClientRouter />
		
		<!-- Primary Meta Tags -->
		<title>{title}</title>
		<meta name="title" content={title} />
		<meta name="description" content={description} />
		<meta name="keywords" content="小説家になろう, なろう, カクヨム, 読書アプリ, 小説ビューアー, 縦書き, オフライン読書, Flutter, Novelty, Google Play" />
		<meta name="theme-color" content="#084887" />
		<link rel="canonical" href={Astro.url} />

		<!-- Open Graph / Facebook -->
		<meta property="og:type" content={type} />
		<meta property="og:url" content={Astro.url} />
		<meta property="og:site_name" content="Novelty" />
		<meta property="og:locale" content="ja_JP" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={new URL(image, Astro.url)} />

		<!-- Twitter -->
		<meta property="twitter:card" content="summary_large_image" />
		<meta property="twitter:site" content="@R0u9h" />
		<meta property="twitter:creator" content="@R0u9h" />
		<meta property="twitter:url" content={Astro.url} />
		<meta property="twitter:title" content={title} />
		<meta property="twitter:description" content={description} />
		<meta property="twitter:image" content={new URL(image, Astro.url)} />

		<!-- Structured Data (JSON-LD) -->
		<script type="application/ld+json">
			[
				{
					"@context": "https://schema.org",
					"@type": "WebSite",
					"name": "Novelty",
					"url": "https://novelty.l4ph.moe",
					"description": "なろう・カクヨム対応の小説ビューアー",
					"publisher": {
						"@type": "Organization",
						"name": "Novelty Project",
						"logo": {
							"@type": "ImageObject",
							"url": "https://novelty.l4ph.moe/favicon.svg"
						}
					}
				},
				{
					"@context": "https://schema.org",
					"@type": "SoftwareApplication",
					"name": "Novelty",
					"operatingSystem": "iOS, Android, Windows, macOS, Linux",
					"applicationCategory": "ReadingApplication",
					"description": "「小説家になろう」「カクヨム」を縦書きで快適に読むための小説ビューアー。広告なし、オフライン対応。",
					"offers": {
						"@type": "Offer",
						"price": "0",
						"priceCurrency": "JPY"
					},
					"author": {
						"@type": "Organization",
						"name": "Novelty Project",
						"url": "https://github.com/L4Ph/Novelty"
					},
					"screenshot": [
						"https://novelty.l4ph.moe/tategaki.webp",
						"https://novelty.l4ph.moe/explorer.webp",
						"https://novelty.l4ph.moe/library.webp",
						"https://novelty.l4ph.moe/history.webp"
					],
					"featureList": "縦書き表示, オフライン読書, なろう・カクヨム対応"
				}
			]
		</script>
		<slot name="head" />
	</head>
	<body>
		<slot />
	</body>
</html>

<style is:global>
  ::selection {
    background-color: color-mix(in oklch, var(--brand-primary) 25%, transparent);
  }
</style>
