---
import { GITHUB_RELEASES_URL } from "../lib/store-links";
---

<header class="header">
  <div class="container">
    <nav class="navbar" aria-label="サイトナビゲーション">
      <div class="navbar-start">
        <a href="/" class="logo-link">
          <img src="/favicon.svg" alt="Novelty" class="logo-img" />
          <span class="logo-text">Novelty</span>
        </a>
      </div>

      <div class="navbar-center only-desktop">
        <ul class="menu-horizontal">
          <li><a href="/#features">機能</a></li>
          <li><a href="/#tech">技術</a></li>
          <li><a href="/help">よくある質問</a></li>
        </ul>
      </div>

      <div class="navbar-end">
        <a
          href={GITHUB_RELEASES_URL}
          class="btn btn-primary"
        >
          ダウンロード
        </a>
        <a
          href="https://github.com/L4Ph/Novelty"
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-ghost only-desktop"
        >
          GitHub
        </a>
      </div>
    </nav>
    <nav class="mobile-nav only-mobile" aria-label="モバイルナビゲーション">
      <a href="/#features">機能</a>
      <a href="/#tech">技術</a>
      <a href="/help">よくある質問</a>
    </nav>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    width: 100%;
    background-color: var(--surface-page);
    border-bottom: 1px solid var(--border-subtle);
  }

  .navbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 4rem;
    padding: 0.5rem 0;
  }

  .navbar-start,
  .navbar-end {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .logo-link {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .logo-img {
    width: 2rem;
    height: 2rem;
  }

  .logo-text {
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--brand-primary);
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.75rem;
    padding: 0 1.25rem;
    border-radius: var(--radius-md);
    font-weight: 700;
    font-size: 0.9375rem;
    border: 1px solid transparent;
  }

  .btn-primary {
    background-color: var(--brand-primary);
    color: var(--text-on-brand);
  }
  .btn-primary:hover {
    background-color: var(--brand-primary-hover);
  }

  .btn-ghost {
    background: transparent;
    color: var(--text-secondary);
  }
  .btn-ghost:hover {
    background-color: var(--surface-sunken);
  }

  .menu-horizontal {
    display: flex;
    gap: 0.25rem;
    padding: 0;
    margin: 0;
    list-style: none;
  }
  .menu-horizontal a {
    display: block;
    padding: 0.5rem 1rem;
    font-weight: 700;
    font-size: 0.9375rem;
    color: var(--text-secondary);
    border-radius: var(--radius-md);
  }
  .menu-horizontal a:hover {
    color: var(--brand-primary);
    background-color: var(--surface-soft);
  }

  /* 1024px未満はモバイル表示、以上はデスクトップ表示 */
  .only-desktop {
    display: none;
  }

  .mobile-nav {
    display: flex;
    gap: 0.25rem;
    padding-bottom: 0.5rem;
  }
  .mobile-nav a {
    padding: 0.5rem 0.75rem;
    font-weight: 700;
    font-size: 0.875rem;
    color: var(--text-secondary);
    border-radius: var(--radius-md);
  }

  .only-mobile {
    display: flex;
  }
  nav.only-mobile.mobile-nav {
    display: flex;
  }

  @media (min-width: 1024px) {
    .only-desktop {
      display: inline-flex;
    }
    ul.only-desktop {
      display: flex;
    }
    .only-mobile {
      display: none;
    }
    nav.only-mobile.mobile-nav {
      display: none;
    }
  }
</style>
