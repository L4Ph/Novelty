---
import SectionHeader from "./SectionHeader.astro";

// 技術カード1件分の形。category/title/descriptionの3点が常に一緒に旅するため型で束ねる。
interface TechStackItem {
  category: string;
  title: string;
  description: string;
}

const techStacks: TechStackItem[] = [
  {
    category: "Framework",
    title: "Flutter",
    description: "美しく、高速で、直感的なUI。すべてのOSへの対応を一本化し、読書効率を最大化します。"
  },
  {
    category: "State Management",
    title: "Riverpod",
    description: "堅牢な状態管理とリアクティブな設計。データの流れを透明化し、バグの少ない安定性を実現。"
  },
  {
    category: "Database",
    title: "Drift",
    description: "型安全なSQLite。ページ履歴やダウンロードした小説を高速かつ確実に管理します。"
  },
  {
    category: "Internal Tool",
    title: "narou_parser",
    description: "「小説家になろう」のために独自開発。高速なHTML解析と正確なデータ変換を担うエンジン。"
  },
  {
    category: "Internal Tool",
    title: "tategaki",
    description: "小説の「読みやすさ」に妥協しない。Web技術では難解な縦書き表示を Flutter で実現した独自ライブラリ。"
  },
  {
    category: "Internal Tool",
    title: "kakuyomu_parser",
    description: "「カクヨム」のために独自開発。公開HTMLの取得解析と正確なデータ変換を担うエンジン。"
  }
];
---

<section id="tech" class="section">
  <div class="container">
    <SectionHeader eyebrow="Technical Craftsmanship" title="信頼を支える技術" withDivider />

    <div class="grid">
      {techStacks.map(tech => (
        <div class="card group">
          <div class="mb-6">
            <span class="badge">
              {tech.category}
            </span>
            <h3 class="card-title">{tech.title}</h3>
          </div>
          
          <p class="card-description">
            {tech.description}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .section {
    padding: var(--space-section) 0;
    background-color: var(--surface-page);
  }

  /* Grid */
  .grid {
    display: grid;
    gap: 1.5rem;
  }

  /* Card */
  .card {
    padding: 1.75rem;
    background-color: var(--surface-raised);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-xl);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
  }

  .mb-6 { margin-bottom: 1.25rem; }

  /* Badge */
  .badge {
    display: inline-block;
    padding: 0.25rem 0.75rem;
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--brand-primary);
    background-color: var(--surface-soft);
    border-radius: 9999px;
    margin-bottom: 0.75rem;
  }

  .card-title {
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--text-primary);
    margin: 0;
  }

  .card-description {
    color: var(--text-secondary);
    line-height: 1.8;
    font-size: 0.9375rem;
    margin: 0;
  }

  /* Responsive */
  @media (min-width: 768px) { /* md */
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) { /* lg */
    .section {
      padding: 8rem 0; /* py-32 */
    }
    .header {
      margin-bottom: 6rem; /* mb-24 */
    }
    .title {
      font-size: 3rem; /* 5xl */
    }
    .grid {
      grid-template-columns: repeat(3, 1fr);
    }
    .card-description {
      font-size: 1rem; /* text-base */
    }
  }
</style>
