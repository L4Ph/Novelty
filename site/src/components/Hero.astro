---
import { GITHUB_RELEASES_URL, BETA_GROUP_URL } from "../lib/store-links";
---

<section class="hero-section">
  <div class="container hero-grid">
    <div class="hero-copy">
      <p class="badge">広告なし・オフライン対応</p>

      <h1 class="headline">
        Novelty
        <span class="sub-headline">なろう・カクヨムを読むための小説ビューアー</span>
      </h1>

      <p class="description">
        「小説家になろう」「カクヨム」の作品を、縦書きの落ち着いた画面で読めます。
        保存した本は圏外でも開けます。
      </p>

      <div class="cta-group">
        <a
          href={GITHUB_RELEASES_URL}
          class="btn btn-primary"
        >
          アプリをダウンロード
        </a>
        <a
          href={BETA_GROUP_URL}
          class="btn btn-secondary"
        >
          ベータに参加
        </a>
      </div>
    </div>

    <div class="hero-shot">
      <img
        src="/tategaki.webp"
        alt="Noveltyの縦書き読書画面"
        width="768"
        height="1623"
        fetchpriority="high"
      />
    </div>
  </div>
</section>

<style>
  .hero-section {
    background-color: var(--surface-page);
    padding-top: 4rem;
    padding-bottom: var(--space-section);
  }

  .hero-grid {
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }

  .badge {
    display: inline-block;
    padding: 0.375rem 0.875rem;
    border-radius: 9999px;
    background-color: var(--surface-soft);
    border: 1px solid var(--border-subtle);
    color: var(--brand-primary);
    font-size: 0.8125rem;
    font-weight: 700;
    margin: 0 0 1.25rem;
  }

  .headline {
    font-size: 2.75rem;
    font-weight: 900;
    letter-spacing: -0.02em;
    line-height: 1.15;
    color: var(--text-primary);
    margin-bottom: 1rem;
  }

  .sub-headline {
    display: block;
    margin-top: 0.75rem;
    font-family: var(--font-serif);
    font-size: 1.375rem;
    font-weight: 700;
    color: var(--text-secondary);
    letter-spacing: 0;
  }

  .description {
    font-size: 1rem;
    color: var(--text-secondary);
    line-height: 1.9;
    margin: 0 0 2rem;
    max-width: 32rem;
  }

  .cta-group {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    align-items: stretch;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 3.25rem;
    padding: 0 1.75rem;
    border-radius: var(--radius-lg);
    font-weight: 700;
    text-decoration: none;
    border: 1px solid transparent;
  }

  .btn-primary {
    background-color: var(--brand-primary);
    color: var(--text-on-brand);
  }
  .btn-primary:hover {
    background-color: var(--brand-primary-hover);
  }

  .btn-secondary {
    background-color: var(--surface-soft);
    color: var(--brand-primary);
    border-color: var(--border-strong);
  }

  .btn-ghost {
    background-color: transparent;
    color: var(--text-secondary);
  }
  .btn-ghost:hover {
    background-color: var(--surface-sunken);
  }

  .hero-shot {
    display: flex;
    justify-content: center;
  }

  .hero-shot img {
    width: min(100%, 19rem);
    height: auto;
    border-radius: var(--radius-xl);
    border: 1px solid var(--border-subtle);
    background-color: var(--surface-sunken);
  }

  @media (min-width: 1024px) {
    .hero-grid {
      grid-template-columns: 1.1fr 0.9fr;
      gap: 4rem;
    }
    .headline {
      font-size: 3.5rem;
    }
    .cta-group {
      flex-direction: row;
      flex-wrap: wrap;
      align-items: center;
    }
  }
</style>
